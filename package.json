{
    "name": "my-vanilla-project",
    "version": "1.0.0",
    "description": "Enterprise Expense Management System",
    "main": "index.html",
    "scripts": {
        "start": "npx serve .",
        "start:payments": "node api/crypto-payments-server.js",
        "test": "node _test.js",
        "env:sync": "node scripts/sync-env.js",
        "build": "node scripts/sync-env.js && node scripts/build-dist.mjs",
        "build:win": "node scripts/sync-env.js && powershell -Command \"if (-not (Test-Path dist)) { New-Item -Path dist -ItemType Directory | Out-Null }; npx -y minify index.html | Out-File -FilePath dist/index.html -Encoding utf8; Get-ChildItem -Path . -File | Where-Object { $_.Name -ne 'index.html' -and $_.Name -ne 'package-lock.json' -and $_.Name -ne 'package.json' -and -not $_.Name.StartsWith('.') -and $_.Extension -ne '.log' -and $_.Name -ne 'Expense Tracker.code-workspace' } | ForEach-Object { Copy-Item $_.FullName -Destination dist/ -Force }; Get-ChildItem -Path . -Directory | Where-Object { @('node_modules','.git','dist','www','.firebase','.wrangler','android') -notcontains $_.Name } | ForEach-Object { Copy-Item $_.FullName -Destination dist -Recurse -Force -ErrorAction SilentlyContinue }; Get-ChildItem -Path dist -Directory -Recurse -ErrorAction SilentlyContinue | Where-Object { @('node_modules','.git','.wrangler','.next') -contains $_.Name } | ForEach-Object { Remove-Item $_.FullName -Recurse -Force -ErrorAction SilentlyContinue }\""
    },
    "keywords": [
        "expense",
        "tracker",
        "admin",
        "enterprise"
    ],
    "author": "Mitanshu Bhasin",
    "license": "ISC",
    "dependencies": {
        "@capacitor/android": "^6.1.2",
        "@capacitor/core": "^6.1.2",
        "@fastify/busboy": "^3.2.4",
        "@firebase/database-compat": "^2.1.7",
        "@firebase/database-types": "^1.0.22",
        "@genkit-ai/googleai": "^1.28.0",
        "@google-cloud/firestore": "^9.4.0",
        "@google-cloud/language": "^7.2.1",
        "@google-cloud/paginator": "^7.2.0",
        "@google-cloud/projectify": "^6.2.1",
        "@google-cloud/promisify": "^6.2.1",
        "@google-cloud/storage": "^8.4.0",
        "@nodable/entities": "^3.1.0",
        "@protobufjs/codegen": "^2.0.5",
        "@protobufjs/eventemitter": "^1.1.1",
        "@protobufjs/fetch": "^1.1.1",
        "@protobufjs/utf8": "^1.1.2",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/ms": "^2.1.0",
        "anynum": "^1.0.1",
        "async-retry": "^1.3.3",
        "dotenv": "^16.6.1",
        "express": "^4.22.1",
        "fast-xml-builder": "^1.3.1",
        "fast-xml-parser": "^5.11.2",
        "firebase": "^12.10.0",
        "firebase-admin": "^14.5.0",
        "functional-red-black-tree": "^1.0.1",
        "genkit": "^1.31.0",
        "google-auth-library": "^11.3.1",
        "google-gax": "^4.6.1",
        "is-unsafe": "^2.0.2",
        "jose": "^6.2.13",
        "jsonwebtoken": "^9.0.3",
        "jwks-rsa": "^4.1.0",
        "limiter": "^1.1.5",
        "lodash.clonedeep": "^4.5.0",
        "lodash.includes": "^4.3.0",
        "lodash.isboolean": "^3.0.3",
        "lodash.isinteger": "^4.0.4",
        "lodash.isnumber": "^3.0.3",
        "lodash.isplainobject": "^4.0.6",
        "lodash.isstring": "^4.0.1",
        "lodash.once": "^4.1.1",
        "lru-cache": "^11.5.3",
        "lru-memoizer": "^3.0.0",
        "mime": "^3.0.0",
        "p-limit": "^3.1.0",
        "path-expression-matcher": "^1.6.2",
        "protobufjs": "^7.6.6",
        "puppeteer": "^24.41.0",
        "retry": "^0.13.1",
        "retry-request": "^9.1.0",
        "serve": "^14.2.0",
        "strnum": "^2.5.1",
        "teeny-request": "^11.1.1",
        "typescript": "^7.0.2",
        "winston": "^3.19.0",
        "xml-naming": "^0.3.0"
    },
    "devDependencies": {
        "@capacitor/assets": "^3.0.5",
        "@capacitor/cli": "^6.1.2",
        "html-minifier-terser": "^7.2.0",
        "minify": "^11.0.0",
        "postal-mime": "^2.7.3",
        "wrangler": "^4.72.0"
    }
}
